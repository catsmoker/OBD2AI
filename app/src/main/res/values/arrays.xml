<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline AI Easter-egg library (Offline AI ONLY — never Online AI).

  Community-driven joke pools. To contribute a line:
  1. Add one <item> to the matching pool below (keep it short, TTS-friendly,
     no profanity, no % signs, use ’ for apostrophes so nothing needs escaping).
  2. Never joke about a specific fault code or mimic a safety warning —
     Easter eggs play IN ADDITION to the normal warning, never instead of it.
  3. Tune odds in LiveDataFragment.easterPoolConfig, not here.
  4. To retire a line, delete its <item> (recent-play tracking is in memory,
     so nothing else needs cleanup).

  Kept English-only on purpose (translatable="false"): meme/racing humor
  does not survive translation, and the locale-parity unit test only pins
  <string> keys, so these arrays never break it.
-->
<resources>

    <!-- Rising edge across 130 km/h. -->
    <string-array name="easter_speed_130" translatable="false">
        <item>Yo, speed racer, relax.</item>
        <item>Alright, I see you.</item>
        <item>Someone’s in a hurry.</item>
        <item>Bro thinks this is qualifying.</item>
        <item>Okay, Lightning McQueen.</item>
        <item>Yo, easy there.</item>
        <item>Alright, speed racer.</item>
        <item>You woke up and chose speed.</item>
    </string-array>

    <!-- Rising edge across 140 km/h. -->
