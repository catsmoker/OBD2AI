<?xml version="1.0" encoding="utf-8"?>
<!-- OBD2 AI 2.0: AI-side chat bubble. Same 12dp geometry as bg_badge so the
     two speakers feel like one system, but a neutral surface so the driver's
     primary-container bubble stays distinct. -->
