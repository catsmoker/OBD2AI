<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.catsmoker.obd2ai.ui.onboarding.OnboardingFragment"
        android:label="fragment_onboarding"
        tools:layout="@layout/fragment_onboarding" >
        <action
            android:id="@+id/action_onboardingFragment_to_permissionsFragment"
            app:destination="@id/permissionsFragment"/>
        <action
            android:id="@+id/action_onboardingFragment_to_connectFragment"
            app:destination="@id/connectFragment"/>
        <action
            android:id="@+id/action_onboardingFragment_to_liveDataFragment"
            app:destination="@id/liveDataFragment"/>

    </fragment>

    <fragment
        android:id="@+id/permissionsFragment"
        android:name="com.catsmoker.obd2ai.ui.onboarding.PermissionsFragment"
        android:label="fragment_permissions"
        tools:layout="@layout/fragment_permissions" >
        <action
            android:id="@+id/action_permissions_to_connectFragment"
            app:destination="@id/connectFragment"
            app:popUpTo="@id/permissionsFragment"
            app:popUpToInclusive="true"/>
    </fragment>

    <fragment
        android:id="@+id/connectFragment"
        android:name="com.catsmoker.obd2ai.ui.connect.ConnectFragment"
        android:label="fragment_connect"
        tools:layout="@layout/fragment_connect" >
        <action
            android:id="@+id/action_connectFragment_to_errorOverviewFragment"
            app:destination="@id/errorOverviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/errorOverviewFragment"
        android:name="com.catsmoker.obd2ai.ui.diagnostics.ErrorOverviewFragment"
        android:label="fragment_error_overview"
        tools:layout="@layout/fragment_error_overview" >
        <action
            android:id="@+id/action_errorOverviewFragment_to_errorDetailFragment"
            app:destination="@id/errorDetailFragment" />
        <action
            android:id="@+id/action_errorOverviewFragment_to_liveDataFragment"
            app:destination="@id/liveDataFragment" />
        <action
            android:id="@+id/action_errorOverviewFragment_to_consoleFragment"
            app:destination="@id/consoleFragment" />
        <action
            android:id="@+id/action_errorOverviewFragment_to_tripFragment"
            app:destination="@id/tripFragment" />
    </fragment>

    <fragment
        android:id="@+id/errorDetailFragment"
        android:name="com.catsmoker.obd2ai.ui.diagnostics.ErrorDetailFragment"
        android:label="fragment_error_detail"
        tools:layout="@layout/fragment_error_detail" >
        <argument
            android:name="errorCode"
            app:argType="string" />
        <action
            android:id="@+id/action_errorDetailFragment_to_askAiFragment"
            app:destination="@id/askAiFragment" />
    </fragment>

    <fragment
        android:id="@+id/askAiFragment"
        android:name="com.catsmoker.obd2ai.ui.diagnostics.AskAiFragment"
        android:label="fragment_ask_ai"
        tools:layout="@layout/fragment_ask_ai" >
        <argument
            android:name="errorCode"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/consoleFragment"
        android:name="com.catsmoker.obd2ai.ui.console.ConsoleFragment"
        android:label="fragment_console"
        tools:layout="@layout/fragment_console" />

    <fragment
        android:id="@+id/tripFragment"
        android:name="com.catsmoker.obd2ai.ui.trip.TripFragment"
        android:label="fragment_trip"
        tools:layout="@layout/fragment_trip" />

    <fragment
        android:id="@+id/liveDataFragment"
        android:name="com.catsmoker.obd2ai.ui.dashboard.LiveDataFragment"
        android:label="fragment_live_data"
        tools:layout="@layout/fragment_live_data" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.catsmoker.obd2ai.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settingsFragment_to_aboutFragment"
            app:destination="@id/aboutFragment" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="com.catsmoker.obd2ai.ui.settings.AboutFragment"
        android:label="fragment_about"
        tools:layout="@layout/fragment_about" />

</navigation>