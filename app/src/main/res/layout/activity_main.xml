<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".MainActivity">

    <!-- Phone top navigation: compact in-flow icon bar with the same six
         destinations as the tablet rail. In-flow (never overlaid) so it can
         never cover fragment controls like the dashboard mute/demo row.
         Hidden during the first-run flow. -->
    <LinearLayout
        android:id="@+id/top_nav_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/button_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_small"
        android:weightSum="6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/dashboard_title"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_gauge"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/nav_diagnostics"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/error_overview_title"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_engine"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/nav_trip"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/trip_title"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_route"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/nav_console"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/obd_console_title"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_terminal"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/nav_about"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_min_height"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_about_title"
            android:padding="@dimen/spacing_small"
            android:src="@drawable/ic_info"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/adView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_nav_bar"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-3940256099942544/9214589741"
        android:layerType="software" />

</androidx.constraintlayout.widget.ConstraintLayout>